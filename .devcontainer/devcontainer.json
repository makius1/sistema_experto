{
  "name": "Sistemas Expertos e IA - Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "files.encoding": "utf8",
        "files.eol": "\n",
        "editor.rulers": [88],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "python --version && pip install --upgrade pip && pip install -r requirements.txt",

  "remoteUser": "vscode"
}
